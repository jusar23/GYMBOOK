# Required for mobile sign-in and optional manual Supabase backups.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Public RevenueCat SDK keys. Create both app integrations and the gymbook_premium
# entitlement in RevenueCat before enabling subscription access.
VITE_RC_ANDROID_API_KEY=
VITE_RC_WEB_API_KEY=
VITE_RC_ENTITLEMENT_ID=gymbook_premium

# Optional public URL for the signed Android APK shown on the informational website.
# Upload the release APK to a file host and set the same value in Vercel's build environment.
VITE_ANDROID_APK_URL=

# Public Gym Book Training social links (leave blank until the official profiles exist).
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_X_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_PUBLIC_WEBSITE_URL=https://gymbooktraining.com/
