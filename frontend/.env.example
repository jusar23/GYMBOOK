# Required for mobile sign-in and optional manual Supabase backups.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Public RevenueCat SDK keys. Create the gymbook_training_premium entitlement and
# attach the yearly and monthly products in RevenueCat before enabling subscriptions.
# Keep test_ keys in ignored local env files only; use the Android app key for releases.
VITE_RC_ANDROID_API_KEY=
VITE_RC_WEB_API_KEY=
VITE_RC_ENTITLEMENT_ID=gymbook_training_premium

# Optional public URL for the signed Android APK shown on the informational website.
# Upload the release APK to a file host and set the same value in Vercel's build environment.
VITE_ANDROID_APK_URL=

# Official social links are defined in src/lib/brand-links.js.
VITE_PUBLIC_WEBSITE_URL=https://gymbooktraining.com/
