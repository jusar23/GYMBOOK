# Copy to .env and add the Supabase project's public API URL and publishable/anon key.
# The key may be included in the frontend build; never put a service_role key here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional local settings
WEB_PORT=8080
RP_ID=localhost
ORIGIN=http://localhost:8080
RP_NAME=GYMBOOK
